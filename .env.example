# ─────────────────────────────────────────────────────────────
# EasyExam — Environment Variables Template
# Copy this file to .env and fill in real values.
# .env is GITIGNORED — never commit secrets.
# ─────────────────────────────────────────────────────────────

# Django settings module — controls which environment loads
# Options: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Django secret key — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Set to True in dev, False in prod
DEBUG=True

# Comma-separated hostnames for ALLOWED_HOSTS (prod)
# Example: ALLOWED_HOSTS=easyexam.in,www.easyexam.in
ALLOWED_HOSTS=127.0.0.1,localhost

# ── PostgreSQL ────────────────────────────────────────────────
DB_NAME=easyexam
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
# Celery broker
REDIS_URL=redis://localhost:6379/0
# Django cache (separate DB index)
CACHE_REDIS_URL=redis://localhost:6379/1

# ── S3-compatible Storage ─────────────────────────────────────
# Leave blank in dev to fall back to local MEDIA_ROOT
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
# For non-AWS providers set the endpoint URL, e.g. Cloudflare R2
AWS_S3_ENDPOINT_URL=

# ── Email ─────────────────────────────────────────────────────
# In dev the console backend is used; these vars are only read in prod
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@easyexam.in
EMAIL_HOST_PASSWORD=your_smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EasyExam <no-reply@easyexam.in>

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
